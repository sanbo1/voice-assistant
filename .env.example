# このファイルを Pi 上で ~/voice-assistant/.env にコピーし、値を記入する。
# .env はコミットしない（.gitignore で除外済み）。

# Gemini API キー（Google AI Studio で発行）
GEMINI_API_KEY=
# 使う Gemini のモデル。空なら既定（gemini-3.6-flash）
GEMINI_MODEL=
# 思考の量（Gemini 3 系：minimal・low・medium・high。モデルにより異なる）。
# 空なら、既定のモデルのときは minimal、ほかのモデルのときはモデルの既定
GEMINI_THINKING_LEVEL=

# 録音・再生に使うデバイス。空なら既定（PipeWire の既定の入出力）を使う。
# 番号またはデバイス名の一部を書く（一覧：venv/bin/python scripts/00_audio_check.py --list）
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
