# このファイルを Pi 上で ~/voice-assistant/.env にコピーし、値を記入する。
# .env はコミットしない（.gitignore で除外済み）。

# Gemini API キー（Google AI Studio で発行）
GEMINI_API_KEY=
# 使う Gemini のモデル。空なら既定（gemini-3.6-flash）
GEMINI_MODEL=
# 思考の量（Gemini 3 系：minimal・low・medium・high。モデルにより異なる）。
# 空なら、既定のモデルのときは minimal、ほかのモデルのときはモデルの既定
GEMINI_THINKING_LEVEL=
# 上のモデルが上限などで使えないときに順に使う予備のモデル（カンマ区切り）。
# 空なら既定（gemini-3.5-flash-lite,gemini-3.1-flash-lite）、none なら予備を使わない
GEMINI_FALLBACK_MODELS=

# 返答のあと、ウェイクワードなしで続けて話せる秒数（空なら 3。0 にすると続けて話す機能を使わない）
FOLLOWUP_SECONDS=
# 1 回のウェイクワードにつき、続けて話せる回数の上限（空なら 3）
FOLLOWUP_MAX_TURNS=

# 音声認識に使うモデル（models/ の中のフォルダ名）。空なら既定の大型（vosk-model-ja-0.22）。
# 小型に戻すときは vosk-model-small-ja-0.22 と書く（先に tools/models.txt で入れておく必要がある）
VOSK_MODEL_DIR=

# 聞き取りの確信度（単語ごとの平均）がこれ未満なら、雑音とみなして AI に送らない。
# 空なら 0.52。0 にすると足切りをしない。呼びかけが無視されるようなら下げる
# （2026-09-22 の実測：雑音だけ 0.465／離れた位置からの質問 0.576〜0.847）
VOSK_MIN_CONFIDENCE=

# ウェイクワード検知の調整（空なら既定値）。変えたらサービスを再起動する。
# スコアがこの値以上のフレームを「立ち上がり」として数える（空なら 0.35）
WAKEWORD_THRESHOLD=
# 何フレーム続けてしきい値を超えたら確認窓に進むか。1 フレーム 80ms（空なら 2）
WAKEWORD_PATIENCE_FRAMES=
# 立ち上がりのあと、何フレームぶんスコアを見てから決めるか（空なら 3＝240ms。0 で確認窓なし）
WAKEWORD_CONFIRM_FRAMES=
# 立ち上がりと確認窓を通した最大スコアがこの値未満なら反応しない（空なら 0＝見送らない）
WAKEWORD_CONFIRM_THRESHOLD=

# 録音・再生に使うデバイス。空なら既定（PipeWire の既定の入出力）を使う。
# 番号またはデバイス名の一部を書く（一覧：venv/bin/python scripts/00_audio_check.py --list）
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
